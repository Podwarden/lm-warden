# LLM Warden — environment contract.
#
# This file is the single source of truth for every variable an install of
# LLM Warden reads. `install.sh` copies it to `.env` and fills in the secrets;
# `scripts/check-env-contract.sh` (run in CI) fails the build if
# docker-compose.yml or the installer references a variable that is not
# described here, or if a default below disagrees with the application code.
#
# Grammar (machine-read by install.sh and by the PodWarden Hub catalog):
#   VAR=value                 a knob with its shipped value
#   VAR=  # REQUIRED          must be non-empty before the stack starts
#   VAR=  # generate:hex32    install.sh fills it with `openssl rand -hex 32`
#   # VAR=value               an optional knob, shown with the application
#                             default; uncomment to change it. Leave these
#                             commented rather than blank: the API parses
#                             numeric values strictly and an empty string is
#                             not "unset".
#
# Variables consumed by Docker Compose itself are grouped first, then the
# VW_* variables the api container reads.

# ---------------------------------------------------------------------------
# Compose
# ---------------------------------------------------------------------------

# Release to run. A CalVer tag such as v2026.09.03.5 (see CHANGELOG.md) pins
# both images -- vllm-warden and vllm-warden-ui -- to that release; `latest`
# floats to the newest one on every `make pull`. Pin it for air-gapped
# installs so `docker load` and the compose file agree on the tag.
VERSION=latest

# Host port the Caddy front door publishes. It is the only published port:
# the UI, the control API and the OpenAI-compatible /v1 endpoint all sit
# behind it. api and ui are internal to the compose network.
WARDEN_PORT=8080

# Compose project name. Fixes the container and volume names
# (vllm-warden_vw-data, vllm-warden_vw-hfcache, ...) regardless of the
# directory the stack is installed in, so backups and the air-gapped cache
# pre-seed in documents/INSTALL.md address a known volume.
COMPOSE_PROJECT_NAME=vllm-warden

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Session-cookie signing key, at least 32 characters. The API refuses to boot
# without it. Keep it stable across restarts: rotating it logs every browser
# session out. install.sh generates it; by hand: openssl rand -hex 32
VW_COOKIE_SECRET= # REQUIRED | generate:hex32

# API-token (JWT) signing secret. Leave blank to auto-mint one on first boot
# and persist it in the data volume. Set it only to share a secret across
# several wardens or to rotate it deliberately.
VW_JWT_SECRET=

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------

# The URL(s) the browser uses to reach the UI, e.g. https://llm.example.com,
# for the CSRF/Origin check on /api/auth/refresh and /api/auth/logout.
# Comma-separate several. Leave blank to accept whatever host the request
# arrived on (fine for a first look and for LAN installs); set it once the
# warden sits behind a public domain. When set, it must match the address
# bar exactly -- a mismatch logs the user out on every reload.
# install.sh --origin URL writes this.
#
# It also decides the session cookies' Secure flag when nothing else can: an
# all-https:// value here means the browser is on TLS even if a terminating
# proxy forwards no header. Over plain http:// the cookies are set without
# Secure, because a browser silently discards a Secure cookie on an http
# origin -- which would leave the session unable to refresh at all.
VW_FRONTEND_ORIGIN=

# 1 = also trust the X-Forwarded-Proto / X-Forwarded-Host a reverse proxy in
# front of Caddy sets, instead of pinning the exact public URL above. Only
# enable it when a proxy you control is the sole way in. The forwarded scheme
# is then also what decides whether session cookies are marked Secure.
VW_TRUST_PROXY_ORIGIN=0

# ---------------------------------------------------------------------------
# GPUs
# ---------------------------------------------------------------------------

# Number of GPUs the api container can see, for request sizing and process
# attribution. install.sh sets it from the GPUs you select (0 for a CPU-only
# control plane). Keep it equal to the device reservation in
# docker-compose.override.yml when editing that file by hand.
VW_CONTAINER_GPU_COUNT=1

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Persistent state directory: the SQLite database (<dir>/vllm-warden.db), the
# auto-minted JWT secret, the HuggingFace token and the engine logs. This
# compose file bakes the mount at /data and does not interpolate the variable,
# so change it only alongside the vw-data volume mount. A PodWarden Hub
# install does interpolate it, to place the directory on its own volume.
# VW_DATA_DIR=/data

# HuggingFace model-weights cache directory. Mounted at the HF library default
# so the cache is found without configuration; the same mount-first rule as
# VW_DATA_DIR applies. Sized for the models you intend to keep resident --
# weights, not metadata, dominate it.
# VW_HF_CACHE_DIR=/root/.cache/huggingface

# ---------------------------------------------------------------------------
# Model cache
# ---------------------------------------------------------------------------

# 1 = never contact huggingface.co: model pulls resolve from the cache volume
# only. For air-gapped hosts with a pre-seeded cache (documents/INSTALL.md: Offline /
# air-gapped install). Read by huggingface_hub and vLLM inside the api
# container.
# HF_HUB_OFFLINE=0

# ---------------------------------------------------------------------------
# Tunables (optional -- uncomment to change; the value shown is the default)
# ---------------------------------------------------------------------------

# Seconds the warm-up probe waits for a freshly loaded model to answer its
# first completion before the load is marked failed. Raise for multimodal
# models with a slow processor warm-up.
# VW_WARMUP_PROBE_TIMEOUT_S=600.0

# Stats-sampler tick cadence in seconds (GPU/VRAM graphs). Values <= 0 fall
# back to the default.
# VW_STATS_SAMPLER_INTERVAL_S=5.0

# Push cadence in seconds of the header metrics SSE stream. Lower is snappier
# and costs more SSE traffic; floored at 0.5.
# VW_HEADER_METRICS_INTERVAL_S=2.0

# Hard wall-clock cap in seconds on a single proxied /v1 request, streaming
# included. 0 = no cap. Set e.g. 600 when clients can hang on very long
# generations.
# VW_REQUEST_MAX_WALL_S=0.0

# true = keep recent prompts and completions in an in-memory ring for the
# operator's request-inspection view. Holds request content in RAM; leave off
# unless you need it.
VW_GODMODE_ENABLED=false

# ---------------------------------------------------------------------------
# Content logging (writes request content to disk -- off by default)
# ---------------------------------------------------------------------------
#
# The only switch in this file that persists prompts and completions to the
# disk. Unlike VW_GODMODE_ENABLED above, which keeps content in RAM and loses
# it on restart, this appends the full prompt and completion text of a request
# as JSON to a file on the persistent data volume, where it stays until
# somebody deletes it -- and where every backup of that volume picks it up.
# It is a diagnostic for chasing runaway or degenerate generations, not an
# audit log; turn it off again when the investigation is over.
#
# Turning it on takes BOTH of the two switches below: the flag, and the
# request's token id listed in VW_CONTENT_LOG_TOKENS, which is empty by
# default. There is deliberately no log-everything mode -- the flag alone
# logs nothing.

# true = arm the content logger. Still logs nothing until at least one token
# id is allowlisted below.
# VW_CONTENT_LOG_ENABLED=false

# Comma-separated API-token ids whose requests are logged, e.g.
# tok_ab12,tok_cd34 (the id shown on the Tokens page, not the secret). Blank
# = log nothing, whatever the flag above says. Keep this to the one token you
# are debugging with: every request it makes lands in the file in full.
# VW_CONTENT_LOG_TOKENS=

# Destination file, one JSON object per line. LEAVE IT BLANK and it follows
# VW_DATA_DIR: <VW_DATA_DIR>/logs/content.jsonl, i.e. the persistent data
# volume, the same volume as the SQLite database. It has to be derived rather
# than pinned -- with a literal /data/logs/content.jsonl, moving VW_DATA_DIR
# left the log writing to a /data that was no longer the mount: the records
# landed on the container's writable layer, filled the NODE's disk instead of
# the volume, and vanished on restart, all three silently. Set it explicitly
# only to put the file somewhere else on purpose (another volume, say); an
# explicit value always wins.
# NOTHING ROTATES OR PRUNES THIS FILE: the stats pruner
# (app/runtime/stats_pruner.py) covers request_history and the sample tables
# and never touches it. Filling that volume is an outage, not a disk-space
# nuisance -- the database is on it, and the API stops being able to write --
# which is what VW_CONTENT_LOG_MAX_BYTES below is for. Watch the size while
# it is on, and delete the file when you are done. Created 0600 in a 0700
# directory.
# VW_CONTENT_LOG_PATH=

# Per-record cap, in characters, applied to the prompt and to the completion
# separately; the excess is dropped and noted in the record. This bounds one
# RECORD, not the file (VW_CONTENT_LOG_MAX_BYTES bounds the file). At the
# default, one logged request can be ~80 KB.
# THERE IS NO VALUE THAT MEANS "UNLIMITED". Unlike VW_REQUEST_MAX_WALL_S
# above, 0 and negative do NOT lift the cap: a negative value is clamped to 0
# with a warning at start-up, and 0 keeps the record's metadata while
# capturing no prompt or completion text at all. To capture more, raise the
# number.
# VW_CONTENT_LOG_MAX_CHARS=40000

# Ceiling on the SIZE OF THE FILE, in bytes. Default 512 MiB. Rationale: the
# PodWarden Hub template pins the vllm-warden-data volume at 10 GiB, shared
# with the SQLite database, so 512 MiB leaves the database an order of
# magnitude of headroom while still holding roughly 6,000 records at the
# ~80 KB a default-capped record costs.
# ON REACHING IT THE LOGGER STOPS WRITING and logs one warning naming the
# file and the ceiling. It does NOT rotate and does NOT delete: the hazard
# here is an outage rather than a tidiness problem -- the database is on this
# volume -- so the right response is a human looking at it, and keeping one
# rotated generation would both make the real budget 2x this number and throw
# away the incidents you turned the logger on to capture. Archive or remove
# the file (or turn VW_CONTENT_LOG_ENABLED off) to resume.
# 0 or negative switches the ceiling off entirely, the same convention
# VW_ENGINE_LOG_MAX_BYTES uses.
# VW_CONTENT_LOG_MAX_BYTES=536870912

# Runaway-generation detector. off = not armed, and the proxy forward path is
# byte-identical to a build without it. log = watch for a model spiralling and
# record the incident without interrupting it. enforce = also tear the
# generation down when it trips.
#
# "log" writes THROUGH the content-log sink above: it is not an independent
# writer, and it records nothing unless VW_CONTENT_LOG_ENABLED is true and the
# request's token is allowlisted. Set all three together, or the detector runs
# and reports into a file nothing opens.
# VW_RUNAWAY_MODE=off
