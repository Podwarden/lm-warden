{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lm-warden-prompt-lens-report",
  "title": "Prompt Lens session report",
  "type": "object",
  "required": ["report_version", "view", "session", "score_version", "weights", "scores", "top", "findings", "turns", "cost"],
  "additionalProperties": false,
  "properties": {
    "report_version": {"const": 1},
    "view": {"enum": ["key", "admin"]},
    "session": {
      "type": "object",
      "required": ["harness", "model", "route", "turns", "duration_s", "prompt_version"],
      "additionalProperties": false,
      "properties": {
        "harness": {"type": "string"},
        "model": {"type": "string"},
        "route": {"type": "string"},
        "turns": {"type": "integer", "minimum": 0},
        "duration_s": {"type": "number", "minimum": 0},
        "prompt_version": {"type": ["string", "null"]}
      }
    },
    "score_version": {"type": "integer"},
    "weights": {"type": "object", "additionalProperties": {"type": "number"}},
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall": {"$ref": "#/$defs/score"},
        "E": {"$ref": "#/$defs/score"},
        "C": {"$ref": "#/$defs/score"},
        "R": {"$ref": "#/$defs/score"}
      }
    },
    "not_scored": {"type": "object", "additionalProperties": {"type": "string"}},
    "top": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "notice": {"anyOf": [{"$ref": "#/$defs/finding"}, {"type": "null"}]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn", "reused", "recomputed", "new", "markers"],
        "additionalProperties": false,
        "properties": {
          "turn": {"type": "string", "pattern": "^T[0-9]+$"},
          "reused": {"type": "integer", "minimum": 0},
          "recomputed": {"type": "integer", "minimum": 0},
          "new": {"type": "integer", "minimum": 0},
          "markers": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cost": {
      "type": "object",
      "required": ["prompt_tokens", "reused_tokens", "recomputed_tokens", "fixable_lost_tokens", "price_card"],
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {"type": "integer"},
        "reused_tokens": {"type": "integer"},
        "recomputed_tokens": {"type": "integer"},
        "fixable_lost_tokens": {"type": "integer"},
        "price_card": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["provider", "model", "currency", "effective_from"],
              "properties": {
                "provider": {"type": "string"},
                "model": {"type": "string"},
                "currency": {"type": "string"},
                "effective_from": {"type": "string"},
                "actual_input": {"type": ["number", "null"]},
                "saving": {"type": ["number", "null"]},
                "saving_pct": {"type": ["integer", "null"]}
              }
            }
          ]
        }
      }
    },
    "review": {"type": ["object", "null"]}
  },
  "$defs": {
    "score": {
      "type": "object",
      "required": ["scored", "turns"],
      "properties": {
        "scored": {"type": "boolean"},
        "turns": {"type": "integer", "minimum": 0},
        "value": {"type": "integer", "minimum": 0, "maximum": 100},
        "lo": {"type": "integer"},
        "hi": {"type": "integer"},
        "confidence": {"enum": ["high", "medium", "low", null]},
        "with_marks": {"type": "integer"},
        "excluded_rules": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]}
      }
    },
    "finding": {
      "type": "object",
      "required": ["rule", "layer", "message", "fix", "turns", "counts", "muted"],
      "properties": {
        "rule": {"type": "string", "pattern": "^[ECR]-[0-9]{2}$"},
        "layer": {"enum": ["E", "C", "R"]},
        "message": {"type": "string"},
        "fix": {"type": "string"},
        "leanprompt": {"type": ["string", "null"]},
        "turns": {"type": "array", "items": {"type": "string", "pattern": "^T[0-9]+$"}},
        "counts": {"type": "object", "additionalProperties": {"type": "integer"}},
        "confidence": {"enum": ["high", "medium", "low", null]},
        "saving": {"type": "object"},
        "muted": {"type": "boolean"},
        "where": {"type": "string"},
        "tool": {"type": "string", "pattern": "^tool #[0-9]+$"},
        "tool_name": {"type": "string"}
      }
    }
  }
}
